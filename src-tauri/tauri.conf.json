{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stackdeck",
  "version": "0.1.0",
  "identifier": "dev.brylix.stackdeck",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stackdeck",
        "width": 1040,
        "height": 720,
        "minWidth": 780,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0"
    },
    "shortDescription": "Local PHP/MariaDB stack manager",
    "longDescription": "Pinned PHP, MariaDB and Caddy with per-site localhost vhosts, loopback by default."
  }
}
